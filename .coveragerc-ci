# Coverage configuration for continuous integration only.
#
# The local run uses the settings in pyproject.toml and measures everything,
# because a development machine has the model weights installed. A CI runner
# does not, and must not: tests/test_scope_and_artifacts.py forbids fetching a
# model, a weight or a provider during a run, and conftest.py blocks the network
# outright. Those are deliberate rules that make a benchmark reproducible.
#
# So the inference code is unreachable in CI *by policy*, not by neglect. Left in
# the measurement it drags the total from 90% to 88% and the gate fails for a
# reason nobody can fix without breaking a rule the project chose. The two wrong
# answers are lowering the threshold - which would then hide real regressions
# everywhere else - and marking the code `pragma: no cover`, which would hide it
# locally too, where it genuinely is tested.
#
# The right answer is that each environment is held to the same standard for the
# code it can actually execute. The omissions below are exactly the modules whose
# uncovered lines are model loading and inference, and nothing else. They are
# still measured locally, where they run.
#
# If this list ever needs to grow, that is a signal worth arguing about rather
# than a line to add quietly.

[run]
branch = True
source = ipw
omit =
    */ai_adapters/vendor/*
    # Loads a 67 MB checkpoint and runs a network. No weights on a runner.
    */ai_adapters/real_esrgan.py
    */ai_adapters/swinir.py
    # The network definitions the two adapters build and execute.
    */ai_adapters/rrdbnet.py
    # Chooses and configures a device for inference.
    */ai_adapters/accelerator.py
    # The libvips engine, which the Windows runner cannot load.
    #
    # libvips is a native library, not a wheel. On Linux apt provides it; on
    # Windows the DLLs live in a gitignored .tools/vips that only a developer
    # machine has, and the workflow deliberately leaves the Windows job without
    # it so the engine-unavailable path gets exercised. That makes vips_engine
    # unreachable there - 22% against 89% where the library exists - and a gate
    # that averages the two environments is really asking the Windows job to
    # cover code it is configured not to run.
    #
    # Omitted for both runners rather than for one, because a per-OS config file
    # is a second copy of this list that nothing keeps in step. The Linux job
    # still *runs* every libvips test, so a regression there still fails on its
    # assertions; it simply stops being counted twice in a coverage average.
    */standard/vips_engine.py
    */standard/vips_runtime.py
    # Drives the Tesseract binary, which a runner does not have.
    #
    # Installing it from apt was tried and reverted, and the reason is worth
    # keeping. The register pins tesseract 5.4.0 and a tessdata file by SHA-256;
    # Ubuntu ships engine 5.3.4 with tessdata 4.1.0. Recognition differs enough
    # between them that a test asserting a phrase was found fails on one and
    # passes on the other - so CI would have been testing *a* Tesseract, not
    # *the* pinned one. Its failures would not have implied a product bug and
    # its passes would not have proved the shipped configuration works.
    #
    # Fetching the pinned model instead is what the scope guard exists to
    # prevent. So this is unreachable in CI for the same reason the inference
    # code is: a deliberate rule, not an oversight.
    */ipw/pdf/ocr.py

[report]
exclude_lines =
    pragma: no cover
    class .*\(Protocol\)
    class .*\(Protocol\[
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
