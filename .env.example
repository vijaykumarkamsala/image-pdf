# Local development settings. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is gitignored; this file is not, and must never carry a real value.
# The service reads `.env` only when it exists, and only for local work - in
# Cloud Run every one of these comes from the deployment instead, so there is
# one image and three configurations rather than three images.
#
# Nothing here is required to run locally. With an empty `.env` the workspace
# still starts, still processes images and documents, and simply has nowhere to
# persist them.


# ------------------------------------------------------------------ where ---
# Which environment this process believes it is. Controls nothing on its own;
# it labels the startup banner, the health endpoint and (later) the licence gate
# that stops an unreviewed component reaching production.
#   local | dev | staging | production
IPW_ENV=local


# ------------------------------------------------------------- networking ---
# Leave these alone locally. Cloud Run sets PORT itself and needs IPW_HOST to be
# 0.0.0.0, because its proxy connects from outside the container - a container
# bound to loopback accepts nothing and looks like a broken deploy.
#
# IPW_ALLOW_PUBLIC_BIND is a deliberate acknowledgement, not a formality: this
# service has no sign-in yet, so anything reachable beyond localhost is an image
# processor strangers can run at your expense. Deploy with
# --no-allow-unauthenticated until authentication exists.
# IPW_HOST=0.0.0.0
# IPW_ALLOW_PUBLIC_BIND=1


# --------------------------------------------------------------- storage ----
# One bucket per environment, so a staging run can never write into
# production's objects. The name here is just the bucket - no gs:// prefix.
#
#   dev         ->  your-dev-bucket
#   staging     ->  your-staging-bucket
#   production  ->  your-prod-bucket
IPW_BUCKET=

# Only needed locally, and only for signing upload URLs. On Cloud Run leave this
# unset: the metadata service supplies credentials, which is both simpler and
# safer than a key file that can be copied.
#
# A downloaded service-account key is a long-lived credential in a file. Prefer:
#     gcloud auth application-default login
# and set nothing here. Use a key only if that will not work for you.
# GOOGLE_APPLICATION_CREDENTIALS=


# -------------------------------------------------------------- database ----
# Postgres. One database per environment, same as the buckets.
#
# In Cloud Run this must come from Secret Manager, never --set-env-vars: an
# environment variable set on the service is visible to anyone who can describe
# it, and a password in a deploy command ends up in your shell history and your
# CI logs.
#
#   postgresql://user:password@host:5432/dbname
IPW_DATABASE_URL=
