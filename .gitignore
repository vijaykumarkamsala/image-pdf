# ---- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Secrets ------------------------------------------------------------------
.env
.env.*
# The template is the one env file that must be committed: it documents the
# shape without carrying a single real value.
!.env.example

# Google service-account keys. On Cloud Run none of these should exist - the
# metadata service provides credentials - so a file matching these names is
# either a local development convenience or a mistake, and neither belongs in
# a repository other people can read.
*-sa.json
*-key.json
service-account*.json
gcp-*.json
application_default_credentials.json
*.pem
*.key
secrets.json

# ---- Model weights: NEVER commit ----------------------------------------------
# AGENTS.md: "Do not commit private or large benchmark assets to Git."
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.bin
*.tflite
*.gguf
weights/
models/

# ---- Corpus images: never committed -------------------------------------------
# Real evaluation images live in protected storage. Git holds only the manifest,
# asset ids and hashes (PRODUCT_REQUIREMENTS.md section 8).
data/corpus/images/

# ---- Benchmark assets ---------------------------------------------------------
# Large / private corpus images live in protected object storage and are
# referenced from manifests by asset id + hash, never committed.
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.webp
*.bmp
*.gif
*.heic
*.avif
*.pdf
*.zip

# Narrow allowlist: only rights-cleared synthetic fixtures may enter Git.
# All are generated by tools/make_fixtures.py and tools/make_inspection_fixtures.py.
!data/fixtures/images/*.png
!data/fixtures/images/*.jpg
# POC-004 golden outputs: small, generated, and the whole point is that they are
# compared byte for byte, so they must be tracked.
!data/goldens/**/*.png
!data/goldens/**/*.jpg

# ---- Generated benchmark output -----------------------------------------------
data/reports/*
!data/reports/.gitignore
!data/reports/example/
!data/reports/example/**
data/runs/
tmp/
.tmp/
.tmp-goldens/

# ---- Node ---------------------------------------------------------------------
node_modules/
.turbo/
*.tsbuildinfo
# Compiled browser-lab output. Generated by `npm run build`, never committed.
apps/browser-lab/public/dist/

# ---- Local native toolchain (downloaded, never committed) ---------------------
# libvips DLLs for pyvips on Windows. Provenance recorded in .tools/vips-provenance.json
# and in the licence register. Reinstall with: python tools/install_libvips.py
.tools/
data/local-storage/
