{
  "$defs": {
    "FileLocationKind": {
      "enum": [
        "default_files",
        "project"
      ],
      "title": "FileLocationKind",
      "type": "string"
    },
    "FileLocationRef": {
      "additionalProperties": false,
      "properties": {
        "default_files_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Files Id"
        },
        "kind": {
          "$ref": "#/$defs/FileLocationKind"
        },
        "project_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FileLocationRef",
      "type": "object"
    },
    "WorkspaceFile": {
      "additionalProperties": false,
      "properties": {
        "asset_original_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Asset Original Id",
          "type": "string"
        },
        "canonical_location": {
          "$ref": "#/$defs/FileLocationRef"
        },
        "current_source_version_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Current Source Version Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "file_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "File Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "workspace_id",
        "asset_original_id",
        "current_source_version_id",
        "display_name",
        "canonical_location"
      ],
      "title": "WorkspaceFile",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/file-list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "$ref": "#/$defs/WorkspaceFile"
      },
      "title": "Files",
      "type": "array"
    },
    "schema_version": {
      "default": "1.14.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "files"
  ],
  "title": "FileList",
  "type": "object"
}
