{
  "$defs": {
    "PdfRendererIdentity": {
      "additionalProperties": false,
      "properties": {
        "licence_component_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Licence Component Ids",
          "type": "array"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "default": "1.21.0",
          "title": "Schema Version",
          "type": "string"
        },
        "standard_font_sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Standard Font Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "licence_component_ids",
        "standard_font_sha256"
      ],
      "title": "PdfRendererIdentity",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/pdf-export-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "minimum": 1,
      "title": "Byte Size",
      "type": "integer"
    },
    "created_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "document_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Id",
      "type": "string"
    },
    "document_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Version Id",
      "type": "string"
    },
    "filename": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "media_type": {
      "const": "application/pdf",
      "default": "application/pdf",
      "title": "Media Type",
      "type": "string"
    },
    "object_reference_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Object Reference Id",
      "type": "string"
    },
    "page_count": {
      "maximum": 500,
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "pdf_export_request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Pdf Export Request Id",
      "type": "string"
    },
    "pdf_export_result_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Pdf Export Result Id",
      "type": "string"
    },
    "renderer": {
      "$ref": "#/$defs/PdfRendererIdentity"
    },
    "schema_version": {
      "default": "1.21.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "description": "Lower-case hexadecimal SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "pdf_export_result_id",
    "pdf_export_request_id",
    "workspace_id",
    "document_id",
    "document_version_id",
    "filename",
    "byte_size",
    "sha256",
    "page_count",
    "renderer",
    "object_reference_id",
    "created_at"
  ],
  "title": "PdfExportResult",
  "type": "object"
}
