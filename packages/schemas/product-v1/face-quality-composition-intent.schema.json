{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/face-quality-composition-intent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acknowledged_possible_identity_change": {
      "const": true,
      "title": "Acknowledged Possible Identity Change",
      "type": "boolean"
    },
    "allow_reconstructed_face_detail": {
      "const": true,
      "title": "Allow Reconstructed Face Detail",
      "type": "boolean"
    },
    "base_output_sha256": {
      "description": "Lower-case hexadecimal SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Output Sha256",
      "type": "string"
    },
    "candidate_request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Candidate Request Id",
      "type": "string"
    },
    "candidate_sha256": {
      "description": "Lower-case hexadecimal SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "contract_version": {
      "const": "image-quality-face-v1",
      "title": "Contract Version",
      "type": "string"
    },
    "source_sha256": {
      "description": "Lower-case hexadecimal SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "candidate_request_id",
    "candidate_sha256",
    "source_sha256",
    "base_output_sha256",
    "allow_reconstructed_face_detail",
    "acknowledged_possible_identity_change"
  ],
  "title": "FaceQualityCompositionIntent",
  "type": "object"
}
