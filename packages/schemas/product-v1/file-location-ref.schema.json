{
  "$defs": {
    "FileLocationKind": {
      "enum": [
        "default_files",
        "project"
      ],
      "title": "FileLocationKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/file-location-ref.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "default_files_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Files Id"
    },
    "kind": {
      "$ref": "#/$defs/FileLocationKind"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "schema_version": {
      "default": "1.15.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "kind"
  ],
  "title": "FileLocationRef",
  "type": "object"
}
