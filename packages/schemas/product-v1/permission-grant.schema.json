{
  "$defs": {
    "Permission": {
      "enum": [
        "workspace.read",
        "project.create",
        "project.read",
        "file.create",
        "file.read",
        "file.move",
        "audit.read",
        "usage.read",
        "upload.create",
        "upload.read",
        "upload.cancel",
        "job.read",
        "job.cancel",
        "job.retry",
        "notification.read",
        "notification.update",
        "search.read",
        "document.create",
        "document.read",
        "document.edit",
        "document.version",
        "document.lease.takeover"
      ],
      "title": "Permission",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/permission-grant.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Actor Id",
      "type": "string"
    },
    "allowed": {
      "title": "Allowed",
      "type": "boolean"
    },
    "grant_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Grant Id",
      "type": "string"
    },
    "permission": {
      "$ref": "#/$defs/Permission"
    },
    "schema_version": {
      "default": "1.13.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "grant_id",
    "workspace_id",
    "actor_id",
    "permission",
    "allowed"
  ],
  "title": "PermissionGrant",
  "type": "object"
}
