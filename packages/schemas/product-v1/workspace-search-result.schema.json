{
  "$defs": {
    "SearchResultKind": {
      "enum": [
        "project",
        "file",
        "job"
      ],
      "title": "SearchResultKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/workspace-search-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SearchResultKind"
    },
    "path": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "resource_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Resource Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.12.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "resource_id",
    "title",
    "description",
    "path",
    "updated_at"
  ],
  "title": "WorkspaceSearchResult",
  "type": "object"
}
