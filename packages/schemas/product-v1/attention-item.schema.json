{
  "$defs": {
    "AttentionKind": {
      "enum": [
        "job_retry",
        "job_failed",
        "upload_interrupted",
        "upload_rejected",
        "source_expiring"
      ],
      "title": "AttentionKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/attention-item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "$ref": "#/$defs/AttentionKind"
    },
    "message": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "occurred_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Occurred At",
      "type": "string"
    },
    "path": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "resource_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Resource Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.10.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "resource_id",
    "title",
    "message",
    "path",
    "occurred_at"
  ],
  "title": "AttentionItem",
  "type": "object"
}
