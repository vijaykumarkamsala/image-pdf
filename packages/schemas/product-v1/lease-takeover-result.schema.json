{
  "$defs": {
    "EditorLeaseGrant": {
      "additionalProperties": false,
      "properties": {
        "lease": {
          "$ref": "#/$defs/EditorLeaseRecord"
        },
        "lease_token": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Lease Token",
          "type": "string"
        },
        "schema_version": {
          "default": "1.17.0",
          "title": "Schema Version",
          "type": "string"
        },
        "takeover_warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Takeover Warning"
        }
      },
      "required": [
        "lease",
        "lease_token"
      ],
      "title": "EditorLeaseGrant",
      "type": "object"
    },
    "EditorLeaseRecord": {
      "additionalProperties": false,
      "properties": {
        "acquired_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Acquired At",
          "type": "string"
        },
        "actor_display_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Actor Display Name",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Document Id",
          "type": "string"
        },
        "expires_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Expires At",
          "type": "string"
        },
        "grace_expires_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Grace Expires At",
          "type": "string"
        },
        "heartbeat_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Heartbeat At",
          "type": "string"
        },
        "lease_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Lease Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.17.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/EditorLeaseState"
        }
      },
      "required": [
        "lease_id",
        "document_id",
        "actor_id",
        "actor_display_name",
        "state",
        "acquired_at",
        "heartbeat_at",
        "expires_at",
        "grace_expires_at"
      ],
      "title": "EditorLeaseRecord",
      "type": "object"
    },
    "EditorLeaseState": {
      "enum": [
        "active",
        "grace",
        "released",
        "expired"
      ],
      "title": "EditorLeaseState",
      "type": "string"
    },
    "LeaseTakeoverStatus": {
      "enum": [
        "requested",
        "acquired"
      ],
      "title": "LeaseTakeoverStatus",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/lease-takeover-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "current_editor": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditorLeaseRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "grant": {
      "anyOf": [
        {
          "$ref": "#/$defs/EditorLeaseGrant"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.17.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/LeaseTakeoverStatus"
    }
  },
  "required": [
    "status"
  ],
  "title": "LeaseTakeoverResult",
  "type": "object"
}
