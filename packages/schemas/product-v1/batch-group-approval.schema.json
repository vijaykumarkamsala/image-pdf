{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/batch-group-approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confirmation_state": {
      "const": "confirmed",
      "title": "Confirmation State",
      "type": "string"
    },
    "group_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Group Id",
      "type": "string"
    },
    "representative_client_item_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Representative Client Item Id",
      "type": "string"
    },
    "representative_preview_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Representative Preview Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.21.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "representative_client_item_id",
    "representative_preview_id",
    "confirmation_state"
  ],
  "title": "BatchGroupApproval",
  "type": "object"
}
