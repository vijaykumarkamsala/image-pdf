{
  "$defs": {
    "BatchGroupReport": {
      "additionalProperties": false,
      "properties": {
        "cancelled_count": {
          "maximum": 50,
          "minimum": 0,
          "title": "Cancelled Count",
          "type": "integer"
        },
        "compatibility_sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Compatibility Sha256",
          "type": "string"
        },
        "exception_count": {
          "maximum": 50,
          "minimum": 0,
          "title": "Exception Count",
          "type": "integer"
        },
        "failed_count": {
          "maximum": 50,
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "group_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Group Id",
          "type": "string"
        },
        "item_count": {
          "maximum": 50,
          "minimum": 1,
          "title": "Item Count",
          "type": "integer"
        },
        "label": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "queued_count": {
          "maximum": 50,
          "minimum": 0,
          "title": "Queued Count",
          "type": "integer"
        },
        "representative_item_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Representative Item Id",
          "type": "string"
        },
        "representative_preview_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Representative Preview Id",
          "type": "string"
        },
        "running_count": {
          "maximum": 50,
          "minimum": 0,
          "title": "Running Count",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.21.0",
          "title": "Schema Version",
          "type": "string"
        },
        "succeeded_count": {
          "maximum": 50,
          "minimum": 0,
          "title": "Succeeded Count",
          "type": "integer"
        }
      },
      "required": [
        "group_id",
        "label",
        "compatibility_sha256",
        "representative_item_id",
        "representative_preview_id",
        "item_count",
        "queued_count",
        "running_count",
        "succeeded_count",
        "failed_count",
        "cancelled_count",
        "exception_count"
      ],
      "title": "BatchGroupReport",
      "type": "object"
    },
    "BatchItemState": {
      "enum": [
        "excluded",
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "BatchItemState",
      "type": "string"
    },
    "BatchOutputReport": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Size"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        },
        "failure_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Message"
        },
        "filename": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "output_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Output Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.21.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "description": "Lower-case hexadecimal SHA-256 digest.",
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "output_id",
        "filename",
        "state",
        "sha256",
        "failure_code",
        "failure_message"
      ],
      "title": "BatchOutputReport",
      "type": "object"
    },
    "BatchReportItem": {
      "additionalProperties": false,
      "properties": {
        "batch_item_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Batch Item Id",
          "type": "string"
        },
        "client_item_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Client Item Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "exception_codes": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Exception Codes",
          "type": "array"
        },
        "group_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Group Id"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/BatchOutputReport"
          },
          "maxItems": 64,
          "title": "Outputs",
          "type": "array"
        },
        "schema_version": {
          "default": "1.21.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/BatchItemState"
        }
      },
      "required": [
        "batch_item_id",
        "client_item_id",
        "group_id",
        "display_name",
        "state",
        "exception_codes",
        "outputs"
      ],
      "title": "BatchReportItem",
      "type": "object"
    },
    "BatchRunState": {
      "enum": [
        "queued",
        "running",
        "partially_completed",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "BatchRunState",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/batch-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Batch Id",
      "type": "string"
    },
    "cancelled_count": {
      "maximum": 50,
      "minimum": 0,
      "title": "Cancelled Count",
      "type": "integer"
    },
    "excluded_count": {
      "maximum": 49,
      "minimum": 0,
      "title": "Excluded Count",
      "type": "integer"
    },
    "failed_count": {
      "maximum": 50,
      "minimum": 0,
      "title": "Failed Count",
      "type": "integer"
    },
    "generated_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Generated At",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/BatchGroupReport"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Groups",
      "type": "array"
    },
    "item_count": {
      "maximum": 50,
      "minimum": 1,
      "title": "Item Count",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BatchReportItem"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "name": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "queued_count": {
      "maximum": 50,
      "minimum": 0,
      "title": "Queued Count",
      "type": "integer"
    },
    "running_count": {
      "maximum": 50,
      "minimum": 0,
      "title": "Running Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.21.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/BatchRunState"
    },
    "succeeded_count": {
      "maximum": 50,
      "minimum": 0,
      "title": "Succeeded Count",
      "type": "integer"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "batch_id",
    "workspace_id",
    "name",
    "state",
    "item_count",
    "queued_count",
    "running_count",
    "succeeded_count",
    "failed_count",
    "cancelled_count",
    "excluded_count",
    "groups",
    "items",
    "generated_at"
  ],
  "title": "BatchReport",
  "type": "object"
}
