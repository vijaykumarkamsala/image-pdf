{
  "$defs": {
    "UploadTransferKind": {
      "enum": [
        "single",
        "resumable"
      ],
      "title": "UploadTransferKind",
      "type": "string"
    },
    "UploadTransferProtocol": {
      "enum": [
        "ipw_offset_json",
        "gcs_resumable"
      ],
      "title": "UploadTransferProtocol",
      "type": "string"
    },
    "UploadTransferProvider": {
      "enum": [
        "local_api",
        "google_cloud_storage"
      ],
      "title": "UploadTransferProvider",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/upload-authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Expires At",
      "type": "string"
    },
    "method": {
      "const": "PUT",
      "default": "PUT",
      "title": "Method",
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/UploadTransferProtocol"
    },
    "provider": {
      "$ref": "#/$defs/UploadTransferProvider"
    },
    "required_headers": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Required Headers",
      "type": "object"
    },
    "resume_token": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Resume Token",
      "type": "string"
    },
    "schema_version": {
      "default": "1.11.0",
      "title": "Schema Version",
      "type": "string"
    },
    "transfer_kind": {
      "$ref": "#/$defs/UploadTransferKind"
    },
    "upload_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Upload Url",
      "type": "string"
    }
  },
  "required": [
    "transfer_kind",
    "provider",
    "protocol",
    "upload_url",
    "expires_at",
    "resume_token"
  ],
  "title": "UploadAuthorization",
  "type": "object"
}
