{
  "$defs": {
    "SharedAssetKind": {
      "enum": [
        "raster",
        "vector",
        "brand"
      ],
      "title": "SharedAssetKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/shared-asset-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_original_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Original Id"
    },
    "kind": {
      "$ref": "#/$defs/SharedAssetKind"
    },
    "linked_by_default": {
      "default": false,
      "title": "Linked By Default",
      "type": "boolean"
    },
    "name": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "object_reference_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Reference Id"
    },
    "preview_object_reference_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Object Reference Id"
    },
    "schema_version": {
      "default": "1.21.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shared_asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Shared Asset Id",
      "type": "string"
    },
    "source_bit_depth": {
      "anyOf": [
        {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Bit Depth"
    },
    "source_byte_size": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Byte Size"
    },
    "source_colour_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Colour Model"
    },
    "source_frame_count": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Frame Count"
    },
    "source_has_icc_profile": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Has Icc Profile"
    },
    "source_height_px": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Height Px"
    },
    "source_media_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Media Type"
    },
    "source_orientation": {
      "anyOf": [
        {
          "maximum": 8,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Orientation"
    },
    "source_version_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Version Id"
    },
    "source_width_px": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Width Px"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "shared_asset_id",
    "workspace_id",
    "kind",
    "name"
  ],
  "title": "SharedAssetRecord",
  "type": "object"
}
