{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/audit-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "actor_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Actor Id",
      "type": "string"
    },
    "audit_event_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Audit Event Id",
      "type": "string"
    },
    "occurred_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Occurred At",
      "type": "string"
    },
    "resource_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Resource Id",
      "type": "string"
    },
    "resource_kind": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Resource Kind",
      "type": "string"
    },
    "schema_version": {
      "default": "1.14.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Trace Id",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "audit_event_id",
    "workspace_id",
    "actor_id",
    "action",
    "resource_kind",
    "resource_id",
    "occurred_at",
    "trace_id"
  ],
  "title": "AuditEvent",
  "type": "object"
}
