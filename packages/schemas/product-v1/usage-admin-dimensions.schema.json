{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/usage-admin-dimensions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dimensions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Dimensions",
      "type": "object"
    },
    "schema_version": {
      "default": "1.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "usage_event_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Usage Event Id",
      "type": "string"
    }
  },
  "required": [
    "usage_event_id"
  ],
  "title": "UsageAdminDimensions",
  "type": "object"
}
