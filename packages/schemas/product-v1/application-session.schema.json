{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Actor Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "schema_version": {
          "default": "1.11.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "display_name"
      ],
      "title": "Actor",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/application-session.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "authenticated": {
      "const": true,
      "default": true,
      "title": "Authenticated",
      "type": "boolean"
    },
    "expires_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Expires At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.11.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "actor",
    "expires_at"
  ],
  "title": "ApplicationSession",
  "type": "object"
}
