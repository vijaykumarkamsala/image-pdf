{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/source-version-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_original_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Asset Original Id",
      "type": "string"
    },
    "created_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "object_reference_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Object Reference Id",
      "type": "string"
    },
    "previous_source_version_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Source Version Id"
    },
    "schema_version": {
      "default": "1.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "source_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Source Version Id",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "source_version_id",
    "workspace_id",
    "asset_original_id",
    "object_reference_id",
    "sequence",
    "created_at"
  ],
  "title": "SourceVersionRecord",
  "type": "object"
}
