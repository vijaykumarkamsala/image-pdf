{
  "$defs": {
    "ExportOutputState": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "ExportOutputState",
      "type": "string"
    },
    "ZipManifestItem": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "filename": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "output_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Output Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.19.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "output_id",
        "filename",
        "sha256",
        "byte_size"
      ],
      "title": "ZipManifestItem",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/export-zip-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "byte_size": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Byte Size"
    },
    "created_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Expires At",
      "type": "string"
    },
    "export_request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Export Request Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ZipManifestItem"
      },
      "title": "Items",
      "type": "array"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Job Id",
      "type": "string"
    },
    "object_reference_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Reference Id"
    },
    "schema_version": {
      "default": "1.19.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "state": {
      "$ref": "#/$defs/ExportOutputState"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "workspace_id",
    "export_request_id",
    "job_id",
    "state",
    "items",
    "expires_at",
    "created_at"
  ],
  "title": "ExportZipBundle",
  "type": "object"
}
