{
  "$defs": {
    "Collection": {
      "additionalProperties": false,
      "properties": {
        "collection_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Collection Id",
          "type": "string"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "default": "1.12.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "collection_id",
        "workspace_id",
        "name"
      ],
      "title": "Collection",
      "type": "object"
    },
    "ProjectRecord": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "default": false,
          "title": "Archived",
          "type": "boolean"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent_project_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Project Id"
        },
        "project_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.12.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "workspace_id",
        "name"
      ],
      "title": "ProjectRecord",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/project-list.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Collection"
      },
      "title": "Collections",
      "type": "array"
    },
    "projects": {
      "items": {
        "$ref": "#/$defs/ProjectRecord"
      },
      "title": "Projects",
      "type": "array"
    },
    "schema_version": {
      "default": "1.12.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "projects"
  ],
  "title": "ProjectList",
  "type": "object"
}
