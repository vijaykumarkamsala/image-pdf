{
  "$defs": {
    "SharedStyleKind": {
      "enum": [
        "fill",
        "stroke",
        "text",
        "effect",
        "brand"
      ],
      "title": "SharedStyleKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/shared-style-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "$ref": "#/$defs/SharedStyleKind"
    },
    "name": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "properties": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Properties",
      "type": "object"
    },
    "schema_version": {
      "default": "1.14.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shared_style_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Shared Style Id",
      "type": "string"
    }
  },
  "required": [
    "shared_style_id",
    "name",
    "kind"
  ],
  "title": "SharedStyleRecord",
  "type": "object"
}
