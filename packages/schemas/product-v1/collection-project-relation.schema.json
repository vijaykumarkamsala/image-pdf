{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/collection-project-relation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collection_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Collection Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.10.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "collection_id",
    "project_id"
  ],
  "title": "CollectionProjectRelation",
  "type": "object"
}
