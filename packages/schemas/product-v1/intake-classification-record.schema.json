{
  "$defs": {
    "IntakeEvidenceLabel": {
      "enum": [
        "verified",
        "likely",
        "unknown"
      ],
      "title": "IntakeEvidenceLabel",
      "type": "string"
    },
    "IntakeSourceCategory": {
      "enum": [
        "photograph",
        "graphic",
        "document",
        "scan",
        "animation",
        "other",
        "unsure"
      ],
      "title": "IntakeSourceCategory",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/intake-classification-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence_percent": {
      "default": null,
      "description": "Compatibility field. Numeric confidence is unavailable until a calibrated method is approved.",
      "title": "Confidence Percent",
      "type": "null"
    },
    "customer_category": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntakeSourceCategory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "default": [],
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_label": {
      "$ref": "#/$defs/IntakeEvidenceLabel",
      "default": "unknown"
    },
    "inferred_category": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntakeSourceCategory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.14.0",
      "title": "Schema Version",
      "type": "string"
    },
    "updated_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Updated At",
      "type": "string"
    },
    "upload_session_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Upload Session Id",
      "type": "string"
    }
  },
  "required": [
    "upload_session_id",
    "updated_at"
  ],
  "title": "IntakeClassificationRecord",
  "type": "object"
}
