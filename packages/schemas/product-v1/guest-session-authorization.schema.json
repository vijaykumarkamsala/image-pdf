{
  "$defs": {
    "GuestSessionRecord": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Expires At",
          "type": "string"
        },
        "guest_session_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Guest Session Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.10.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "guest_session_id",
        "expires_at"
      ],
      "title": "GuestSessionRecord",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/guest-session-authorization.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "guest_session": {
      "$ref": "#/$defs/GuestSessionRecord"
    },
    "schema_version": {
      "default": "1.10.0",
      "title": "Schema Version",
      "type": "string"
    },
    "token": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Token",
      "type": "string"
    }
  },
  "required": [
    "guest_session",
    "token"
  ],
  "title": "GuestSessionAuthorization",
  "type": "object"
}
