{
  "$defs": {
    "IdentityProviderKind": {
      "enum": [
        "local_test",
        "oidc"
      ],
      "title": "IdentityProviderKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/identity-reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Actor Id",
      "type": "string"
    },
    "identity_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Identity Id",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/IdentityProviderKind"
    },
    "provider_subject": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Provider Subject",
      "type": "string"
    },
    "schema_version": {
      "default": "1.7.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "identity_id",
    "actor_id",
    "provider",
    "provider_subject"
  ],
  "title": "IdentityReference",
  "type": "object"
}
