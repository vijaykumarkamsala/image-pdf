{
  "$defs": {
    "ComparisonMode": {
      "enum": [
        "original",
        "current",
        "recommended",
        "split",
        "side_by_side"
      ],
      "title": "ComparisonMode",
      "type": "string"
    },
    "HistogramSummary": {
      "additionalProperties": false,
      "properties": {
        "blue": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Blue",
          "type": "array"
        },
        "green": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Green",
          "type": "array"
        },
        "highlight_clipping": {
          "title": "Highlight Clipping",
          "type": "boolean"
        },
        "red": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Red",
          "type": "array"
        },
        "schema_version": {
          "default": "1.18.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shadow_clipping": {
          "title": "Shadow Clipping",
          "type": "boolean"
        }
      },
      "required": [
        "red",
        "green",
        "blue",
        "shadow_clipping",
        "highlight_clipping"
      ],
      "title": "HistogramSummary",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/enhancement-preview.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "document_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Id",
      "type": "string"
    },
    "document_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Version Id",
      "type": "string"
    },
    "height": {
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "histogram": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistogramSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mode": {
      "$ref": "#/$defs/ComparisonMode"
    },
    "preview_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Preview Id",
      "type": "string"
    },
    "proxy": {
      "const": true,
      "default": true,
      "title": "Proxy",
      "type": "boolean"
    },
    "quality_label": {
      "const": "Interactive proxy; final output is rendered by a durable worker",
      "default": "Interactive proxy; final output is rendered by a durable worker",
      "title": "Quality Label",
      "type": "string"
    },
    "recipe_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Recipe Id",
      "type": "string"
    },
    "recipe_version": {
      "minimum": 1,
      "title": "Recipe Version",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.18.0",
      "title": "Schema Version",
      "type": "string"
    },
    "width": {
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "preview_id",
    "document_id",
    "document_version_id",
    "recipe_id",
    "recipe_version",
    "mode",
    "width",
    "height",
    "created_at"
  ],
  "title": "EnhancementPreview",
  "type": "object"
}
