{
  "$defs": {
    "HistogramSummary": {
      "additionalProperties": false,
      "properties": {
        "blue": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Blue",
          "type": "array"
        },
        "green": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Green",
          "type": "array"
        },
        "highlight_clipping": {
          "title": "Highlight Clipping",
          "type": "boolean"
        },
        "red": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Red",
          "type": "array"
        },
        "schema_version": {
          "default": "1.18.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shadow_clipping": {
          "title": "Shadow Clipping",
          "type": "boolean"
        }
      },
      "required": [
        "red",
        "green",
        "blue",
        "shadow_clipping",
        "highlight_clipping"
      ],
      "title": "HistogramSummary",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/enhancement-preview.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artboard_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Artboard Id",
      "type": "string"
    },
    "authoritative": {
      "const": true,
      "default": true,
      "title": "Authoritative",
      "type": "boolean"
    },
    "byte_size": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Byte Size"
    },
    "created_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "document_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Id",
      "type": "string"
    },
    "document_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Version Id",
      "type": "string"
    },
    "export_request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Export Request Id",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "height": {
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "histogram": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistogramSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "media_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Type"
    },
    "mode": {
      "enum": [
        "original",
        "current",
        "recommended"
      ],
      "title": "Mode",
      "type": "string"
    },
    "object_reference_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Reference Id"
    },
    "output_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Output Id",
      "type": "string"
    },
    "preview_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Preview Id",
      "type": "string"
    },
    "proxy": {
      "const": false,
      "default": false,
      "title": "Proxy",
      "type": "boolean"
    },
    "quality_label": {
      "const": "Authoritative registered preview rendered from the immutable document version",
      "default": "Authoritative registered preview rendered from the immutable document version",
      "title": "Quality Label",
      "type": "string"
    },
    "recipe_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Recipe Id",
      "type": "string"
    },
    "recipe_version": {
      "minimum": 1,
      "title": "Recipe Version",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.18.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "width": {
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "preview_id",
    "document_id",
    "document_version_id",
    "recipe_id",
    "recipe_version",
    "mode",
    "state",
    "export_request_id",
    "output_id",
    "artboard_id",
    "width",
    "height",
    "created_at"
  ],
  "title": "EnhancementPreview",
  "type": "object"
}
