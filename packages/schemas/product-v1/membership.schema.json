{
  "$defs": {
    "RolePreset": {
      "enum": [
        "owner",
        "admin",
        "member",
        "viewer"
      ],
      "title": "RolePreset",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/membership.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Actor Id",
      "type": "string"
    },
    "membership_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Membership Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/RolePreset"
    },
    "schema_version": {
      "default": "1.9.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "membership_id",
    "workspace_id",
    "actor_id",
    "role"
  ],
  "title": "Membership",
  "type": "object"
}
