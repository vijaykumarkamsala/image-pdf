{
  "$defs": {
    "Permission": {
      "enum": [
        "workspace.read",
        "project.create",
        "project.read",
        "file.create",
        "file.read",
        "file.move",
        "audit.read",
        "usage.read",
        "upload.create",
        "upload.read",
        "upload.cancel",
        "job.read",
        "job.cancel",
        "job.retry",
        "notification.read",
        "notification.update",
        "search.read",
        "document.create",
        "document.read",
        "document.edit",
        "document.version",
        "document.lease.takeover"
      ],
      "title": "Permission",
      "type": "string"
    },
    "PermissionOrigin": {
      "enum": [
        "role",
        "workspace_grant"
      ],
      "title": "PermissionOrigin",
      "type": "string"
    },
    "RolePreset": {
      "enum": [
        "owner",
        "admin",
        "member",
        "viewer"
      ],
      "title": "RolePreset",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/effective-permission.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed": {
      "title": "Allowed",
      "type": "boolean"
    },
    "grant_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grant Id"
    },
    "origin": {
      "$ref": "#/$defs/PermissionOrigin"
    },
    "permission": {
      "$ref": "#/$defs/Permission"
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/RolePreset"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.14.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "permission",
    "allowed",
    "origin"
  ],
  "title": "EffectivePermission",
  "type": "object"
}
