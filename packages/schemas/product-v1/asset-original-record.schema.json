{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/asset-original-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset_original_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Asset Original Id",
      "type": "string"
    },
    "created_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    },
    "object_reference_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Object Reference Id",
      "type": "string"
    },
    "original_filename": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Original Filename",
      "type": "string"
    },
    "schema_version": {
      "default": "1.12.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "asset_original_id",
    "workspace_id",
    "object_reference_id",
    "original_filename",
    "created_at"
  ],
  "title": "AssetOriginalRecord",
  "type": "object"
}
