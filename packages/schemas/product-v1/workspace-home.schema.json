{
  "$defs": {
    "AttentionItem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/AttentionKind"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "occurred_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Occurred At",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Resource Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.16.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resource_id",
        "title",
        "message",
        "path",
        "occurred_at"
      ],
      "title": "AttentionItem",
      "type": "object"
    },
    "AttentionKind": {
      "enum": [
        "job_retry",
        "job_failed",
        "upload_interrupted",
        "upload_rejected",
        "source_expiring"
      ],
      "title": "AttentionKind",
      "type": "string"
    },
    "CustomerUsageActivity": {
      "additionalProperties": false,
      "properties": {
        "event_kind": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Event Kind",
          "type": "string"
        },
        "occurred_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Occurred At",
          "type": "string"
        },
        "schema_version": {
          "default": "1.16.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "event_kind",
        "occurred_at"
      ],
      "title": "CustomerUsageActivity",
      "type": "object"
    },
    "IntakeFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.16.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "IntakeFailure",
      "type": "object"
    },
    "NotificationKind": {
      "enum": [
        "upload_accepted",
        "upload_rejected",
        "job_completed",
        "job_failed",
        "job_cancelled",
        "retry_required",
        "retry_completed",
        "guest_handoff_completed",
        "source_cleanup_required",
        "lease_takeover_requested"
      ],
      "title": "NotificationKind",
      "type": "string"
    },
    "NotificationRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/NotificationKind"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "notification_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Notification Id",
          "type": "string"
        },
        "occurred_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Occurred At",
          "type": "string"
        },
        "read_at": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read At"
        },
        "resource_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_kind": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Resource Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "1.16.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "notification_id",
        "workspace_id",
        "kind",
        "title",
        "message",
        "resource_kind",
        "resource_id",
        "occurred_at"
      ],
      "title": "NotificationRecord",
      "type": "object"
    },
    "ProcessingJobKind": {
      "enum": [
        "file_intake_inspection",
        "preview_generation"
      ],
      "title": "ProcessingJobKind",
      "type": "string"
    },
    "ProcessingJobRecord": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "attempt": {
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "created_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntakeFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "guest_session_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guest Session Id"
        },
        "heartbeat_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heartbeat At"
        },
        "job_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Job Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ProcessingJobKind"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Expires At"
        },
        "lease_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Owner"
        },
        "max_attempts": {
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "next_attempt_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Attempt At"
        },
        "owner_kind": {
          "$ref": "#/$defs/UploadOwnerKind"
        },
        "progress_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Progress Percent",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.16.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ProcessingJobState"
        },
        "updated_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Updated At",
          "type": "string"
        },
        "upload_session_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upload Session Id"
        },
        "workspace_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        }
      },
      "required": [
        "job_id",
        "kind",
        "owner_kind",
        "state",
        "attempt",
        "max_attempts",
        "progress_percent",
        "created_at",
        "updated_at"
      ],
      "title": "ProcessingJobRecord",
      "type": "object"
    },
    "ProcessingJobState": {
      "enum": [
        "queued",
        "leased",
        "running",
        "retry_wait",
        "cancel_requested",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "ProcessingJobState",
      "type": "string"
    },
    "RecentWorkItem": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RecentWorkKind"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Resource Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.16.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "resource_id",
        "title",
        "description",
        "path",
        "updated_at"
      ],
      "title": "RecentWorkItem",
      "type": "object"
    },
    "RecentWorkKind": {
      "enum": [
        "project",
        "file",
        "native_document"
      ],
      "title": "RecentWorkKind",
      "type": "string"
    },
    "UploadOwnerKind": {
      "enum": [
        "actor",
        "guest"
      ],
      "title": "UploadOwnerKind",
      "type": "string"
    },
    "UsageSummary": {
      "additionalProperties": false,
      "properties": {
        "activities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CustomerUsageActivity"
          },
          "title": "Activities",
          "type": "array"
        },
        "files": {
          "minimum": 0,
          "title": "Files",
          "type": "integer"
        },
        "high_cost_processing": {
          "minimum": 0,
          "title": "High Cost Processing",
          "type": "integer"
        },
        "jobs": {
          "minimum": 0,
          "title": "Jobs",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.16.0",
          "title": "Schema Version",
          "type": "string"
        },
        "storage_bytes": {
          "minimum": 0,
          "title": "Storage Bytes",
          "type": "integer"
        }
      },
      "required": [
        "files",
        "storage_bytes",
        "jobs",
        "high_cost_processing"
      ],
      "title": "UsageSummary",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/workspace-home.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_jobs": {
      "items": {
        "$ref": "#/$defs/ProcessingJobRecord"
      },
      "title": "Active Jobs",
      "type": "array"
    },
    "attention": {
      "items": {
        "$ref": "#/$defs/AttentionItem"
      },
      "title": "Attention",
      "type": "array"
    },
    "notifications": {
      "items": {
        "$ref": "#/$defs/NotificationRecord"
      },
      "title": "Notifications",
      "type": "array"
    },
    "recent_jobs": {
      "items": {
        "$ref": "#/$defs/ProcessingJobRecord"
      },
      "title": "Recent Jobs",
      "type": "array"
    },
    "recent_work": {
      "items": {
        "$ref": "#/$defs/RecentWorkItem"
      },
      "title": "Recent Work",
      "type": "array"
    },
    "schema_version": {
      "default": "1.16.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unread_notification_count": {
      "minimum": 0,
      "title": "Unread Notification Count",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/UsageSummary"
    }
  },
  "required": [
    "recent_work",
    "attention",
    "active_jobs",
    "recent_jobs",
    "notifications",
    "unread_notification_count",
    "usage"
  ],
  "title": "WorkspaceHome",
  "type": "object"
}
