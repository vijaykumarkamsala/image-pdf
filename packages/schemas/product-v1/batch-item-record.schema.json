{
  "$defs": {
    "BatchConfirmationState": {
      "enum": [
        "pending",
        "not_required",
        "confirmed"
      ],
      "title": "BatchConfirmationState",
      "type": "string"
    },
    "BatchItemState": {
      "enum": [
        "excluded",
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "BatchItemState",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/batch-item-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Batch Id",
      "type": "string"
    },
    "batch_item_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Batch Item Id",
      "type": "string"
    },
    "cancelled_output_count": {
      "maximum": 64,
      "minimum": 0,
      "title": "Cancelled Output Count",
      "type": "integer"
    },
    "client_item_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Client Item Id",
      "type": "string"
    },
    "confirmation_state": {
      "$ref": "#/$defs/BatchConfirmationState"
    },
    "display_name": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "document_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Id",
      "type": "string"
    },
    "document_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Version Id",
      "type": "string"
    },
    "exception_codes": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Exception Codes",
      "type": "array"
    },
    "exclusion_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exclusion Reason"
    },
    "export_request_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Export Request Id"
    },
    "failed_output_count": {
      "maximum": 64,
      "minimum": 0,
      "title": "Failed Output Count",
      "type": "integer"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failure Code"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failure Message"
    },
    "group_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Group Id"
    },
    "included": {
      "title": "Included",
      "type": "boolean"
    },
    "job_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Job Id"
    },
    "last_checkpoint_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Checkpoint Key"
    },
    "output_count": {
      "maximum": 64,
      "minimum": 0,
      "title": "Output Count",
      "type": "integer"
    },
    "position": {
      "maximum": 49,
      "minimum": 0,
      "title": "Position",
      "type": "integer"
    },
    "progress_percent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress Percent",
      "type": "integer"
    },
    "recipe_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Recipe Id",
      "type": "string"
    },
    "recipe_version": {
      "minimum": 1,
      "title": "Recipe Version",
      "type": "integer"
    },
    "requires_individual_confirmation": {
      "title": "Requires Individual Confirmation",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.21.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/BatchItemState"
    },
    "succeeded_output_count": {
      "maximum": 64,
      "minimum": 0,
      "title": "Succeeded Output Count",
      "type": "integer"
    },
    "updated_at": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "batch_item_id",
    "batch_id",
    "client_item_id",
    "position",
    "display_name",
    "document_id",
    "document_version_id",
    "recipe_id",
    "recipe_version",
    "group_id",
    "included",
    "exclusion_reason",
    "requires_individual_confirmation",
    "confirmation_state",
    "exception_codes",
    "export_request_id",
    "job_id",
    "state",
    "progress_percent",
    "output_count",
    "succeeded_output_count",
    "failed_output_count",
    "cancelled_output_count",
    "failure_code",
    "failure_message",
    "last_checkpoint_key",
    "updated_at"
  ],
  "title": "BatchItemRecord",
  "type": "object"
}
