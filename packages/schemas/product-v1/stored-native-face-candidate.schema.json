{
  "$defs": {
    "FaceQualityObject": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 4398046511104,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "generation": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Generation",
          "type": "string"
        },
        "object_key": {
          "maxLength": 1024,
          "pattern": "^(immutable|derivative)/[a-z0-9._/-]+$",
          "title": "Object Key",
          "type": "string"
        },
        "owner_scope": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Owner Scope",
          "type": "string"
        },
        "sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "owner_scope",
        "object_key",
        "generation",
        "sha256",
        "byte_size"
      ],
      "title": "FaceQualityObject",
      "type": "object"
    },
    "NativeFaceAlignment": {
      "additionalProperties": false,
      "description": "Integer-only evidence: source pixels times 10**6; coefficients times 10**9.",
      "properties": {
        "confidence_permyriad": {
          "maximum": 10000,
          "minimum": 8500,
          "title": "Confidence Permyriad",
          "type": "integer"
        },
        "detector_sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Detector Sha256",
          "type": "string"
        },
        "reprojection_error_millipixels": {
          "maximum": 24000,
          "minimum": 0,
          "title": "Reprojection Error Millipixels",
          "type": "integer"
        },
        "similarity_nanounits": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
