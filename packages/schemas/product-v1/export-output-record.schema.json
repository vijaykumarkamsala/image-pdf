{
  "$defs": {
    "ExportOutputProfile": {
      "additionalProperties": false,
      "properties": {
        "alpha_behavior": {
          "default": "preserve",
          "enum": [
            "preserve",
            "flatten"
          ],
          "title": "Alpha Behavior",
          "type": "string"
        },
        "background": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Background"
        },
        "bit_depth": {
          "default": 8,
          "enum": [
            8,
            16
          ],
          "title": "Bit Depth",
          "type": "integer"
        },
        "chroma_subsampling": {
          "anyOf": [
            {
              "enum": [
                "4:4:4",
                "4:2:2",
                "4:2:0"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chroma Subsampling"
        },
        "collision_behavior": {
          "default": "suffix",
          "enum": [
            "suffix",
            "fail"
          ],
          "title": "Collision Behavior",
          "type": "string"
        },
        "colour_profile": {
          "default": "srgb",
          "enum": [
            "preserve",
            "srgb",
            "display-p3"
          ],
          "title": "Colour Profile",
          "type": "string"
        },
        "filename_template": {
          "default": "{document}-{artboard}-{profile}",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Filename Template",
          "type": "string"
        },
        "fit": {
          "default": "contain",
          "enum": [
            "contain",
            "cover",
            "stretch"
          ],
          "title": "Fit",
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/ImageExportFormat"
        },
        "height": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "lossless": {
          "default": false,
          "title": "Lossless",
          "type": "boolean"
        },
        "metadata_policy": {
          "$ref": "#/$defs/MetadataPolicy"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "percentage": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percentage"
        },
        "physical_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Height"
        },
        "physical_unit": {
          "anyOf": [
            {
              "enum": [
                "in",
                "mm",
                "cm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Unit"
        },
        "physical_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Width"
        },
        "ppi": {
          "anyOf": [
            {
              "maximum": 9600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ppi"
        },
        "preset_version": {
          "const": "recovery-2e-v1",
          "default": "recovery-2e-v1",
          "title": "Preset Version",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Profile Id",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/ExportPurpose"
        },
        "quality": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality"
        },
        "resampling_algorithm": {
          "$ref": "#/$defs/ResamplingAlgorithm",
          "default": "lanczos"
        },
        "schema_version": {
          "default": "1.22.0",
          "title": "Schema Version",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "profile_id",
        "name",
        "purpose",
        "format"
      ],
      "title": "ExportOutputProfile",
      "type": "object"
    },
    "ExportOutputState": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "ExportOutputState",
      "type": "string"
    },
    "ExportPurpose": {
      "enum": [
        "archival_derivative",
        "web",
        "email",
        "social",
        "presentation",
        "high_resolution_digital",
        "custom"
      ],
      "title": "ExportPurpose",
      "type": "string"
    },
    "HistogramSummary": {
      "additionalProperties": false,
      "properties": {
        "blue": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Blue",
          "type": "array"
        },
        "green": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Green",
          "type": "array"
        },
        "highlight_clipping": {
          "title": "Highlight Clipping",
          "type": "boolean"
        },
        "red": {
          "items": {
            "type": "integer"
          },
          "maxItems": 256,
          "minItems": 16,
          "title": "Red",
          "type": "array"
        },
        "schema_version": {
          "default": "1.22.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shadow_clipping": {
          "title": "Shadow Clipping",
          "type": "boolean"
        }
      },
      "required": [
        "red",
        "green",
        "blue",
        "shadow_clipping",
        "highlight_clipping"
      ],
      "title": "HistogramSummary",
      "type": "object"
    },
    "ImageExportFormat": {
      "enum": [
        "jpeg",
        "png",
        "webp",
        "tiff"
      ],
      "title": "ImageExportFormat",
      "type": "string"
    },
    "MetadataDisposition": {
      "additionalProperties": false,
      "properties": {
        "comments": {
          "enum": [
            "removed",
            "absent"
          ],
          "title": "Comments",
          "type": "string"
        },
        "embedded_thumbnails": {
          "enum": [
            "removed",
            "absent"
          ],
          "title": "Embedded Thumbnails",
          "type": "string"
        },
        "exif": {
          "enum": [
            "preserved-approved-fields",
            "removed",
            "absent"
          ],
          "title": "Exif",
          "type": "string"
        },
        "gps": {
          "enum": [
            "removed",
            "absent"
          ],
          "title": "Gps",
          "type": "string"
        },
        "icc_profiles": {
          "enum": [
            "converted-to-srgb",
            "assumed-srgb-and-tagged",
            "preserved"
          ],
          "title": "Icc Profiles",
          "type": "string"
        },
        "iptc": {
          "enum": [
            "removed",
            "absent"
          ],
          "title": "Iptc",
          "type": "string"
        },
        "maker_notes": {
          "enum": [
            "removed",
            "absent"
          ],
          "title": "Maker Notes",
          "type": "string"
        },
        "orientation": {
          "enum": [
            "normalized",
            "absent"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "private_blocks": {
          "enum": [
            "removed",
            "absent"
          ],
          "title": "Private Blocks",
          "type": "string"
        },
        "schema_version": {
          "default": "1.22.0",
          "title": "Schema Version",
          "type": "string"
        },
        "software_device": {
          "enum": [
            "preserved-approved-fields",
            "removed",
            "absent"
          ],
          "title": "Software Device",
          "type": "string"
        },
        "xmp": {
          "enum": [
            "removed",
            "absent"
          ],
          "title": "Xmp",
          "type": "string"
        }
      },
      "required": [
        "exif",
        "gps",
        "orientation",
        "xmp",
        "iptc",
        "comments",
        "maker_notes",
        "private_blocks",
        "software_device",
        "embedded_thumbnails",
        "icc_profiles"
      ],
      "title": "MetadataDisposition",
      "type": "object"
    },
    "MetadataPolicy": {
      "additionalProperties": false,
      "properties": {
        "preserve_camera": {
          "default": false,
          "title": "Preserve Camera",
          "type": "boolean"
        },
        "preserve_capture_time": {
          "default": false,
          "title": "Preserve Capture Time",
          "type": "boolean"
        },
        "preserve_copyright": {
          "default": true,
          "title": "Preserve Copyright",
          "type": "boolean"
        },
        "preserve_description": {
          "default": false,
          "title": "Preserve Description",
          "type": "boolean"
        },
        "preserve_location": {
          "const": false,
          "default": false,
          "title": "Preserve Location",
          "type": "boolean"
        },
        "remove_embedded_thumbnails": {
          "const": true,
          "default": true,
          "title": "Remove Embedded Thumbnails",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.22.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "MetadataPolicy",
      "type": "object"
    },
    "ResamplingAlgorithm": {
      "enum": [
        "nearest",
        "bilinear",
        "bicubic",
        "lanczos"
      ],
      "title": "ResamplingAlgorithm",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/export-output-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artboard_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Artboard Id",
      "type": "string"
    },
    "byte_size": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Byte Size"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "export_request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Export Request Id",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "filename": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "height": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Height"
    },
    "histogram": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistogramSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "media_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Type"
    },
    "metadata_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetadataDisposition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata_verified": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Verified"
    },
    "object_reference_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Reference Id"
    },
    "output_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Output Id",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/ExportOutputProfile"
    },
    "progress_percent": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress Percent",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.22.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "state": {
      "$ref": "#/$defs/ExportOutputState"
    },
    "width": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Width"
    }
  },
  "required": [
    "output_id",
    "export_request_id",
    "artboard_id",
    "profile",
    "state",
    "progress_percent",
    "filename"
  ],
  "title": "ExportOutputRecord",
  "type": "object"
}
