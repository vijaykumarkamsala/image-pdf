{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/batch-group-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Batch Id",
      "type": "string"
    },
    "compatibility_sha256": {
      "description": "Lower-case hexadecimal SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Compatibility Sha256",
      "type": "string"
    },
    "exception_count": {
      "minimum": 0,
      "title": "Exception Count",
      "type": "integer"
    },
    "group_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Group Id",
      "type": "string"
    },
    "item_count": {
      "maximum": 50,
      "minimum": 1,
      "title": "Item Count",
      "type": "integer"
    },
    "label": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "representative_item_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Representative Item Id",
      "type": "string"
    },
    "representative_preview_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Representative Preview Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.22.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "group_id",
    "batch_id",
    "compatibility_sha256",
    "label",
    "item_count",
    "representative_item_id",
    "representative_preview_id",
    "exception_count"
  ],
  "title": "BatchGroupRecord",
  "type": "object"
}
