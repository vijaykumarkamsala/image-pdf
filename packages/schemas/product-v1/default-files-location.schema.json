{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/default-files-location.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "default_files_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Default Files Id",
      "type": "string"
    },
    "name": {
      "const": "Default Files",
      "default": "Default Files",
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.8.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "default_files_id",
    "workspace_id"
  ],
  "title": "DefaultFilesLocation",
  "type": "object"
}
