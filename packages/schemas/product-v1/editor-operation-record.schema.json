        "layer_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Layer Id",
          "type": "string"
        },
        "layer_type": {
          "$ref": "#/$defs/LayerType"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "opacity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Opacity",
          "type": "number"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "parent_layer_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
