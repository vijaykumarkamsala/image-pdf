        "rich_text": {
          "anyOf": [
            {
              "$ref": "#/$defs/RichTextLayerData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShapeLayerData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shared_style_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
            "type": "string"
