    "LayerTransform": {
      "additionalProperties": false,
      "properties": {
        "flip_x": {
          "default": false,
          "title": "Flip X",
          "type": "boolean"
        },
        "flip_y": {
          "default": false,
          "title": "Flip Y",
          "type": "boolean"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Height",
          "type": "number"
        },
        "rotation_degrees": {
          "default": 0,
          "maximum": 360,
          "minimum": -360,
          "title": "Rotation Degrees",
          "type": "number"
        },
        "scale_x": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Scale X",
          "type": "number"
