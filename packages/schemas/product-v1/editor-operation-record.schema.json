{
  "$defs": {
    "ArtboardBackground": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "#ffffff",
          "title": "Color"
        },
        "kind": {
          "default": "solid",
          "enum": [
            "transparent",
            "solid"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "ArtboardBackground",
      "type": "object"
    },
    "ArtboardOrientation": {
      "enum": [
        "portrait",
        "landscape",
        "square"
      ],
      "title": "ArtboardOrientation",
      "type": "string"
    },
    "ArtboardRecord": {
      "additionalProperties": false,
      "properties": {
        "artboard_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Artboard Id",
          "type": "string"
        },
        "background": {
          "$ref": "#/$defs/ArtboardBackground"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Height",
          "type": "number"
        },
        "intended_use": {
          "$ref": "#/$defs/IntendedUseMetadata"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "orientation": {
          "$ref": "#/$defs/ArtboardOrientation"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/ArtboardUnit",
          "default": "px"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "artboard_id",
        "name",
        "order",
        "width",
        "height",
        "orientation",
        "background",
        "intended_use"
      ],
      "title": "ArtboardRecord",
      "type": "object"
    },
    "ArtboardUnit": {
      "enum": [
        "px",
        "mm",
        "in",
        "pt"
      ],
      "title": "ArtboardUnit",
      "type": "string"
    },
    "AssetInstanceMode": {
      "enum": [
        "linked",
        "independent"
      ],
      "title": "AssetInstanceMode",
      "type": "string"
    },
    "CropRegion": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        },
        "top": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "title": "CropRegion",
      "type": "object"
    },
    "EditableMaskRecord": {
      "additionalProperties": false,
      "properties": {
        "artboard_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Artboard Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "feather": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Feather",
          "type": "number"
        },
        "inverted": {
          "default": false,
          "title": "Inverted",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/MaskKind"
        },
        "mask_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Mask Id",
          "type": "string"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "object_reference_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Reference Id"
        },
        "path_data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Data"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mask_id",
        "artboard_id",
        "name",
        "kind"
      ],
      "title": "EditableMaskRecord",
      "type": "object"
    },
    "EditorMutation": {
      "additionalProperties": false,
      "properties": {
        "adjustments": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualAdjustments"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artboard": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtboardRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/CropRegion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/EditorOperationKind"
        },
        "layer": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditableMaskRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "properties": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Properties",
          "type": "object"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerTransform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "EditorMutation",
      "type": "object"
    },
    "EditorOperationKind": {
      "enum": [
        "layer.add",
        "layer.update",
        "layer.remove",
        "layer.reorder",
        "artboard.add",
        "artboard.update",
        "artboard.remove",
        "mask.update",
        "document.rename"
      ],
      "title": "EditorOperationKind",
      "type": "string"
    },
    "GroupLayerData": {
      "additionalProperties": false,
      "properties": {
        "collapsed": {
          "default": false,
          "title": "Collapsed",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "GroupLayerData",
      "type": "object"
    },
    "IntendedUseKind": {
      "enum": [
        "source",
        "digital",
        "print",
        "custom"
      ],
      "title": "IntendedUseKind",
      "type": "string"
    },
    "IntendedUseMetadata": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/IntendedUseKind"
        },
        "label": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "schema_version": {
          "default": "1.14.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "title": "IntendedUseMetadata",
      "type": "object"
    },
    "LayerRecord": {
      "additionalProperties": false,
