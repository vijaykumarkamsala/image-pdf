        "skew_y_degrees": {
          "default": 0,
          "maximum": 89,
          "minimum": -89,
          "title": "Skew Y Degrees",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1000000,
          "minimum": -1000000,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "LayerTransform",
      "type": "object"
    },
    "LayerType": {
      "enum": [
        "raster_image",
        "vector_svg",
        "rich_text",
        "shape",
        "group",
        "table",
        "section",
        "layout",
        "mask",
        "adjustment",
        "pdf_object",
        "interactive_field"
      ],
