              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Layer Id"
        },
        "raster": {
          "anyOf": [
            {
              "$ref": "#/$defs/RasterLayerData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
