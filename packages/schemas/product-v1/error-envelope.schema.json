{
  "$defs": {
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "schema_version": {
          "default": "1.17.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trace_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "trace_id"
      ],
      "title": "ErrorDetail",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/error-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "error": {
      "$ref": "#/$defs/ErrorDetail"
    },
    "schema_version": {
      "default": "1.17.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
