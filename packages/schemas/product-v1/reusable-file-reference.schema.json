{
  "$defs": {
    "FileReferenceOwnerKind": {
      "enum": [
        "project",
        "document"
      ],
      "title": "FileReferenceOwnerKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/reusable-file-reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "file_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "File Id",
      "type": "string"
    },
    "owner_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Owner Id",
      "type": "string"
    },
    "owner_kind": {
      "$ref": "#/$defs/FileReferenceOwnerKind"
    },
    "purpose": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "reference_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Reference Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.10.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "reference_id",
    "workspace_id",
    "file_id",
    "owner_kind",
    "owner_id",
    "purpose"
  ],
  "title": "ReusableFileReference",
  "type": "object"
}
