{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/zip-manifest-item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "minimum": 1,
      "title": "Byte Size",
      "type": "integer"
    },
    "filename": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "output_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Output Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.19.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "description": "Lower-case hexadecimal SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "output_id",
    "filename",
    "sha256",
    "byte_size"
  ],
  "title": "ZipManifestItem",
  "type": "object"
}
