{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/object-reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "minimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "media_type": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "object_key": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Object Key",
      "type": "string"
    },
    "object_reference_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Object Reference Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "description": "Lower-case hexadecimal SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "object_reference_id",
    "workspace_id",
    "object_key",
    "sha256",
    "media_type",
    "byte_size"
  ],
  "title": "ObjectReference",
  "type": "object"
}
