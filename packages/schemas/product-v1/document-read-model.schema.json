{
  "$defs": {
    "ArtboardBackground": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "#ffffff",
          "title": "Color"
        },
        "kind": {
          "default": "solid",
          "enum": [
            "transparent",
            "solid"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "1.17.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "ArtboardBackground",
      "type": "object"
    },
    "ArtboardOrientation": {
      "enum": [
        "portrait",
        "landscape",
        "square"
      ],
      "title": "ArtboardOrientation",
      "type": "string"
    },
    "ArtboardRecord": {
      "additionalProperties": false,
      "properties": {
        "artboard_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Artboard Id",
          "type": "string"
        },
        "background": {
          "$ref": "#/$defs/ArtboardBackground"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Height",
          "type": "number"
        },
        "intended_use": {
          "$ref": "#/$defs/IntendedUseMetadata"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "orientation": {
          "$ref": "#/$defs/ArtboardOrientation"
        },
        "schema_version": {
          "default": "1.17.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/ArtboardUnit",
          "default": "px"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "artboard_id",
        "name",
        "order",
        "width",
        "height",
        "orientation",
        "background",
        "intended_use"
      ],
      "title": "ArtboardRecord",
      "type": "object"
    },
    "ArtboardUnit": {
      "enum": [
        "px",
        "mm",
        "in",
        "pt"
      ],
      "title": "ArtboardUnit",
      "type": "string"
    },
    "AssetInstanceMode": {
      "enum": [
        "linked",
        "independent"
      ],
      "title": "AssetInstanceMode",
      "type": "string"
    },
    "CropRegion": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "schema_version": {
          "default": "1.17.0",
          "title": "Schema Version",
          "type": "string"
        },
        "top": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "title": "CropRegion",
      "type": "object"
    },
    "DocumentVariantRecord": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "default": false,
          "title": "Active",
          "type": "boolean"
        },
        "based_on_version_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Based On Version Id",
          "type": "string"
        },
        "name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "default": "1.17.0",
          "title": "Schema Version",
          "type": "string"
        },
        "variant_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Variant Id",
          "type": "string"
        }
      },
      "required": [
        "variant_id",
        "name",
        "based_on_version_id"
      ],
      "title": "DocumentVariantRecord",
      "type": "object"
    },
    "DocumentVersionKind": {
      "enum": [
        "initial",
        "autosave_checkpoint",
        "named",
        "restore",
        "save_as"
      ],
      "title": "DocumentVersionKind",
      "type": "string"
    },
    "DocumentVersionRecord": {
      "additionalProperties": false,
      "properties": {
        "based_on_version_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Based On Version Id"
        },
        "created_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "created_by_actor_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Created By Actor Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Document Id",
          "type": "string"
        },
        "document_version_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Document Version Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DocumentVersionKind"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "restored_from_version_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restored From Version Id"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.17.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "snapshot_sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "document_id",
        "sequence",
        "revision",
        "kind",
        "snapshot_sha256",
        "created_by_actor_id",
        "created_at"
      ],
      "title": "DocumentVersionRecord",
      "type": "object"
    },
    "EditableMaskRecord": {
      "additionalProperties": false,
      "properties": {
        "artboard_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
