{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/collection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collection_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Collection Id",
      "type": "string"
    },
    "name": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "collection_id",
    "workspace_id",
    "name"
  ],
  "title": "Collection",
  "type": "object"
}
