{
  "$defs": {
    "PdfPageRecord": {
      "additionalProperties": false,
      "properties": {
        "artboard_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Artboard Id",
          "type": "string"
        },
        "label": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "master_page_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Master Page Id"
        },
        "schema_version": {
          "default": "1.22.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artboard_id",
        "label"
      ],
      "title": "PdfPageRecord",
      "type": "object"
    },
    "PdfPageSizePolicy": {
      "enum": [
        "uniform",
        "mixed"
      ],
      "title": "PdfPageSizePolicy",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/pdf-document-settings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "default_page_name": {
      "default": "A4",
      "maxLength": 2048,
      "minLength": 1,
      "title": "Default Page Name",
      "type": "string"
    },
    "language": {
      "default": "en",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "title": "Language",
      "type": "string"
    },
    "page_size_policy": {
      "$ref": "#/$defs/PdfPageSizePolicy",
      "default": "uniform"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PdfPageRecord"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "schema_version": {
      "default": "1.22.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subject"
    },
    "title": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "pages"
  ],
  "title": "PdfDocumentSettings",
  "type": "object"
}
