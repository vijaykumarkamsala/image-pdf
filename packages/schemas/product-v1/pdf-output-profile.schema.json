{
  "$defs": {
    "PdfOutputProfileId": {
      "enum": [
        "screen"
      ],
      "title": "PdfOutputProfileId",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/pdf-output-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archival_conformance": {
      "const": null,
      "default": null,
      "title": "Archival Conformance",
      "type": "null"
    },
    "colour_space": {
      "const": "srgb",
      "default": "srgb",
      "title": "Colour Space",
      "type": "string"
    },
    "image_quality": {
      "default": 90,
      "maximum": 100,
      "minimum": 1,
      "title": "Image Quality",
      "type": "integer"
    },
    "label": {
      "default": "Screen PDF",
      "maxLength": 2048,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "metadata_policy": {
      "const": "safe",
      "default": "safe",
      "title": "Metadata Policy",
      "type": "string"
    },
    "profile_id": {
      "$ref": "#/$defs/PdfOutputProfileId",
      "default": "screen"
    },
    "profile_version": {
      "default": "1.0.0",
      "maxLength": 2048,
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.22.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tagged_pdf": {
      "const": false,
      "default": false,
      "title": "Tagged Pdf",
      "type": "boolean"
    }
  },
  "title": "PdfOutputProfile",
  "type": "object"
}
