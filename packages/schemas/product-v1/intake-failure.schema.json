{
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/intake-failure.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Code",
      "type": "string"
    },
    "message": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.9.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "IntakeFailure",
  "type": "object"
}
