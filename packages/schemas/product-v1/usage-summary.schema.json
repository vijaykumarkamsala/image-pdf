{
  "$defs": {
    "CustomerUsageActivity": {
      "additionalProperties": false,
      "properties": {
        "event_kind": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Event Kind",
          "type": "string"
        },
        "occurred_at": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Occurred At",
          "type": "string"
        },
        "schema_version": {
          "default": "1.10.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "event_kind",
        "occurred_at"
      ],
      "title": "CustomerUsageActivity",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/product-v1/usage-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CustomerUsageActivity"
      },
      "title": "Activities",
      "type": "array"
    },
    "files": {
      "minimum": 0,
      "title": "Files",
      "type": "integer"
    },
    "high_cost_processing": {
      "minimum": 0,
      "title": "High Cost Processing",
      "type": "integer"
    },
    "jobs": {
      "minimum": 0,
      "title": "Jobs",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.10.0",
      "title": "Schema Version",
      "type": "string"
    },
    "storage_bytes": {
      "minimum": 0,
      "title": "Storage Bytes",
      "type": "integer"
    }
  },
  "required": [
    "files",
    "storage_bytes",
    "jobs",
    "high_cost_processing"
  ],
  "title": "UsageSummary",
  "type": "object"
}
