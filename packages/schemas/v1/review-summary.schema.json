{
  "$defs": {
    "CriticalFailure": {
      "description": "The eight automatic failures from benchmark plan section 8.3.\n\nA separate channel from scores, and dominant over them.",
      "enum": [
        "identity_changed",
        "text_or_logo_changed",
        "content_added_or_removed",
        "severe_tiling_seams",
        "broken_transparency",
        "orientation_corrupted",
        "silent_colour_space_conversion",
        "worse_than_baseline_unwarned"
      ],
      "title": "CriticalFailure",
      "type": "string"
    },
    "ItemVerdict": {
      "additionalProperties": false,
      "description": "What the reviews add up to for one item, and whether that is settled.",
      "properties": {
        "critical_failures": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CriticalFailure"
          },
          "title": "Critical Failures",
          "type": "array"
        },
        "failed": {
          "default": false,
          "description": "True when any reviewer raised any critical failure. Independent of the scores, and dominant over them.",
          "title": "Failed",
          "type": "boolean"
        },
        "label": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Label",
          "type": "string"
        },
        "needs_third_review": {
          "default": false,
          "title": "Needs Third Review",
          "type": "boolean"
        },
        "overall_scores": {
          "default": [],
          "description": "Each reviewer's overall_usefulness score, in reviewer order. The tie rule reads this rather than the aggregate.",
          "items": {
            "type": "integer"
          },
          "title": "Overall Scores",
          "type": "array"
        },
        "reviewer_count": {
          "minimum": 0,
          "title": "Reviewer Count",
          "type": "integer"
        },
        "score_count": {
          "minimum": 0,
          "title": "Score Count",
          "type": "integer"
        },
        "score_sum": {
          "description": "Sum of every dimension score from every reviewer. Stored with score_count instead of a mean so the artifact holds no float.",
          "minimum": 0,
          "title": "Score Sum",
          "type": "integer"
        },
        "third_review_reason": {
          "default": "",
          "title": "Third Review Reason",
          "type": "string"
        }
      },
      "required": [
        "label",
        "reviewer_count",
        "score_sum",
        "score_count"
      ],
      "title": "ItemVerdict",
      "type": "object"
    },
    "OperationKind": {
      "enum": [
        "noop",
        "inspect_only",
        "resize",
        "crop",
        "rotate",
        "flip",
        "adjust",
        "sharpen",
        "denoise",
        "document_clean",
        "enlarge",
        "convert",
        "super_resolution",
        "ai_denoise",
        "jpeg_artifact_repair",
        "face_restore",
        "damage_repair",
        "colourise",
        "background_remove",
        "background_replace"
      ],
      "title": "OperationKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/v1/review-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Aggregated verdicts, grouped the way a decision needs them.",
  "properties": {
    "operation": {
      "$ref": "#/$defs/OperationKind"
    },
    "package_id": {
      "description": "Content-addressed identifier produced by ipw.benchmark_runner.ids.",
      "pattern": "^(run|res|rep|mfst|pol|rt|ast)_[a-z2-7]{32}$",
      "title": "Package Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.5.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "unknown_labels": {
      "default": [],
      "description": "Scores submitted for labels not in the package. Almost always a transcription error, and never something to average in quietly.",
      "items": {
        "type": "string"
      },
      "title": "Unknown Labels",
      "type": "array"
    },
    "unscored_labels": {
      "default": [],
      "description": "Items in the package that no reviewer scored. Reported rather than dropped: a silently missing item looks identical to an item nobody objected to.",
      "items": {
        "type": "string"
      },
      "title": "Unscored Labels",
      "type": "array"
    },
    "verdicts": {
      "items": {
        "$ref": "#/$defs/ItemVerdict"
      },
      "title": "Verdicts",
      "type": "array"
    }
  },
  "required": [
    "package_id",
    "operation",
    "verdicts"
  ],
  "title": "ReviewSummary",
  "type": "object"
}
