{
  "$defs": {
    "StorageObjectRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes held outside the relational database.",
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "object_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Object Name",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "schema_version": {
          "default": "1.6.0",
          "description": "Contract version. Unsupported versions must be rejected before work starts.",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "storage_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Storage Id",
          "type": "string"
        }
      },
      "required": [
        "storage_id",
        "object_name",
        "sha256",
        "media_type",
        "byte_size"
      ],
      "title": "StorageObjectRef",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/v1/source-version.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A source version created from an original, cloud-linked update or imported file.",
  "properties": {
    "asset_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Asset Id",
      "type": "string"
    },
    "external_source_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Source Id"
    },
    "frozen": {
      "default": false,
      "title": "Frozen",
      "type": "boolean"
    },
    "previous_source_version_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Source Version Id"
    },
    "schema_version": {
      "default": "1.6.0",
      "description": "Contract version. Unsupported versions must be rejected before work starts.",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/StorageObjectRef"
    },
    "source_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Source Version Id",
      "type": "string"
    }
  },
  "required": [
    "source_version_id",
    "asset_id",
    "source"
  ],
  "title": "SourceVersion",
  "type": "object"
}
