{
  "$defs": {
    "StorageObjectRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes held outside the relational database.",
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "object_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Object Name",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "schema_version": {
          "default": "1.6.0",
          "description": "Contract version. Unsupported versions must be rejected before work starts.",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "storage_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Storage Id",
          "type": "string"
        }
      },
      "required": [
        "storage_id",
        "object_name",
        "sha256",
        "media_type",
        "byte_size"
      ],
      "title": "StorageObjectRef",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/v1/document-version.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Editable native project/document version.",
  "properties": {
    "approval_state": {
      "default": "draft",
      "title": "Approval State",
      "type": "string"
    },
    "document_version_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Document Version Id",
      "type": "string"
    },
    "package_ref": {
      "$ref": "#/$defs/StorageObjectRef"
    },
    "parent_document_version_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Document Version Id"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.6.0",
      "description": "Contract version. Unsupported versions must be rejected before work starts.",
      "title": "Schema Version",
      "type": "string"
    },
    "source_version_ids": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
        "type": "string"
      },
      "title": "Source Version Ids",
      "type": "array"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "document_version_id",
    "workspace_id",
    "project_id",
    "package_ref"
  ],
  "title": "DocumentVersion",
  "type": "object"
}
