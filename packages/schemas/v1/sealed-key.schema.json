{
  "$defs": {
    "Disposition": {
      "description": "Commercial standing of one component.\n\n``UNKNOWN`` is the default and is deliberately *not* a synonym for \"probably\nfine\": it permits research but blocks every commercial purpose.",
      "enum": [
        "approved",
        "review_required",
        "non_commercial",
        "unknown",
        "blocked"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "SealedEntry": {
      "additionalProperties": false,
      "description": "The provenance of one item. Never shown to a reviewer before scoring.",
      "properties": {
        "asset_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "effective_disposition": {
          "$ref": "#/$defs/Disposition",
          "default": "unknown"
        },
        "eligible_for_commercial_recommendation": {
          "default": false,
          "title": "Eligible For Commercial Recommendation",
          "type": "boolean"
        },
        "is_control": {
          "default": false,
          "title": "Is Control",
          "type": "boolean"
        },
        "label": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Label",
          "type": "string"
        },
        "licence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence Ref"
        },
        "output_sha256": {
          "description": "Digest of the processor's output. The review copy is re-encoded and padded for blinding, so its bytes differ; this is what ties a score to the measured result.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "processor_name": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Processor Name",
          "type": "string"
        },
        "processor_version": {
          "title": "Processor Version",
          "type": "string"
        },
        "result_id": {
          "description": "Content-addressed identifier produced by ipw.benchmark_runner.ids.",
          "pattern": "^(run|res|rep|mfst|pol|rt|ast)_[a-z2-7]{32}$",
          "title": "Result Id",
          "type": "string"
        },
        "run_id": {
          "description": "Content-addressed identifier produced by ipw.benchmark_runner.ids.",
          "pattern": "^(run|res|rep|mfst|pol|rt|ast)_[a-z2-7]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "description": "Lower-case hexadecimal SHA-256 digest.",
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Sha256"
        }
      },
      "required": [
        "label",
        "result_id",
        "run_id",
        "asset_id",
        "processor_name",
        "processor_version",
        "output_sha256"
      ],
      "title": "SealedEntry",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/v1/sealed-key.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The mapping from labels back to runs. Opened only after scores are in.",
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/SealedEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "package_id": {
      "description": "Content-addressed identifier produced by ipw.benchmark_runner.ids.",
      "pattern": "^(run|res|rep|mfst|pol|rt|ast)_[a-z2-7]{32}$",
      "title": "Package Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.6.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "shuffle_seed": {
      "description": "The seed that produced the label ordering. Recorded so the package is reproducible, and sealed so the ordering cannot be predicted from the package alone.",
      "title": "Shuffle Seed",
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "shuffle_seed",
    "entries"
  ],
  "title": "SealedKey",
  "type": "object"
}
