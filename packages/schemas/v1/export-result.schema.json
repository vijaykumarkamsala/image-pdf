{
  "$defs": {
    "ExportState": {
      "description": "Export result state.",
      "enum": [
        "requested",
        "rendered",
        "failed",
        "cancelled"
      ],
      "title": "ExportState",
      "type": "string"
    },
    "FailureCategory": {
      "description": "The ten normalised categories from USER_FLOWS_AND_EDGE_CASES.md section 18.",
      "enum": [
        "invalid_input",
        "unsupported_format",
        "unsupported_feature",
        "safety_limit",
        "entitlement_required",
        "queue_capacity",
        "processor_unavailable",
        "processor_quality_failure",
        "temporary_infrastructure",
        "permanent_processing",
        "cancelled"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "NextAction": {
      "description": "What the caller (ultimately, the customer) can do about a failure.",
      "enum": [
        "change_settings",
        "retry",
        "alternate_route",
        "wait",
        "purchase_capacity",
        "contact_support",
        "none"
      ],
      "title": "NextAction",
      "type": "string"
    },
    "ProductError": {
      "additionalProperties": false,
      "description": "Structured customer-safe error envelope.",
      "properties": {
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "code": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "next_action": {
          "$ref": "#/$defs/NextAction"
        },
        "schema_version": {
          "default": "1.6.0",
          "description": "Contract version. Unsupported versions must be rejected before work starts.",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "error"
        },
        "trace": {
          "$ref": "#/$defs/TraceContext"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "next_action",
        "trace"
      ],
      "title": "ProductError",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "description": "Lineage for a derivative, export, processor result or document version.",
      "properties": {
        "ai_region_map_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StorageObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "model_weight_sha256": {
          "anyOf": [
            {
              "description": "Lower-case hexadecimal SHA-256 digest.",
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Weight Sha256"
        },
        "processor_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processor Id"
        },
        "processor_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processor Version"
        },
        "provenance_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Provenance Id",
          "type": "string"
        },
        "recipe_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Recipe Name",
          "type": "string"
        },
        "schema_version": {
          "default": "1.6.0",
          "description": "Contract version. Unsupported versions must be rejected before work starts.",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "input_refs",
        "recipe_name"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StorageObjectRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes held outside the relational database.",
      "properties": {
        "byte_size": {
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "object_name": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Object Name",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "schema_version": {
          "default": "1.6.0",
          "description": "Contract version. Unsupported versions must be rejected before work starts.",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "description": "Lower-case hexadecimal SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "storage_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Storage Id",
          "type": "string"
        }
      },
      "required": [
        "storage_id",
        "object_name",
        "sha256",
        "media_type",
        "byte_size"
      ],
      "title": "StorageObjectRef",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "description": "Trace context propagated across browser, API, queue, worker and notification paths.",
      "properties": {
        "idempotency_key": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "schema_version": {
          "default": "1.6.0",
          "description": "Contract version. Unsupported versions must be rejected before work starts.",
          "title": "Schema Version",
          "type": "string"
        },
        "trace_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id"
      ],
      "title": "TraceContext",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/v1/export-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Rendered export or failed export outcome.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "export_result_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Export Result Id",
      "type": "string"
    },
    "outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StorageObjectRef"
      },
      "title": "Outputs",
      "type": "array"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProvenanceRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.6.0",
      "description": "Contract version. Unsupported versions must be rejected before work starts.",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ExportState"
    }
  },
  "required": [
    "export_result_id",
    "request_id",
    "state"
  ],
  "title": "ExportResult",
  "type": "object"
}
