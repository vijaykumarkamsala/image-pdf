{
  "$defs": {
    "AssetCategory": {
      "description": "Evaluation corpus categories from the benchmark plan section 5.1.",
      "enum": [
        "modern_mobile_photo",
        "old_photograph",
        "face_portrait",
        "document_screenshot",
        "product_catalogue",
        "illustration_anime",
        "low_light_noisy",
        "background_removal",
        "large_professional",
        "synthetic_fixture"
      ],
      "title": "AssetCategory",
      "type": "string"
    },
    "CriticalFailure": {
      "description": "The eight automatic failures from benchmark plan section 8.3.\n\nA separate channel from scores, and dominant over them.",
      "enum": [
        "identity_changed",
        "text_or_logo_changed",
        "content_added_or_removed",
        "severe_tiling_seams",
        "broken_transparency",
        "orientation_corrupted",
        "silent_colour_space_conversion",
        "worse_than_baseline_unwarned"
      ],
      "title": "CriticalFailure",
      "type": "string"
    },
    "OperationKind": {
      "enum": [
        "noop",
        "inspect_only",
        "resize",
        "crop",
        "rotate",
        "flip",
        "adjust",
        "sharpen",
        "denoise",
        "document_clean",
        "enlarge",
        "convert",
        "super_resolution",
        "ai_denoise",
        "jpeg_artifact_repair",
        "face_restore",
        "damage_repair",
        "colourise",
        "background_remove",
        "background_replace"
      ],
      "title": "OperationKind",
      "type": "string"
    },
    "ReviewDimension": {
      "description": "The ten dimensions from benchmark plan section 8.2, scored 1 to 5.\n\nNot every dimension applies to every result - identity preservation means\nnothing on a product photograph - so a score sheet carries the dimensions it\nwas asked for rather than all ten, and the aggregation never invents a score\nfor a dimension nobody was shown.",
      "enum": [
        "overall_usefulness",
        "natural_appearance",
        "detail_improvement",
        "identity_preservation",
        "text_logo_accuracy",
        "colour_faithfulness",
        "artifact_level",
        "edge_halo_quality",
        "tiling_seam_visibility",
        "preference_over_baseline"
      ],
      "title": "ReviewDimension",
      "type": "string"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "description": "One image placed in front of a reviewer. Carries no provenance at all.",
      "properties": {
        "category": {
          "$ref": "#/$defs/AssetCategory"
        },
        "dimensions": {
          "description": "The dimensions this item is to be scored on. A dimension that does not apply to the material is omitted rather than scored neutrally.",
          "items": {
            "$ref": "#/$defs/ReviewDimension"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "label": {
          "description": "Opaque handle such as 'item-07'. Must not encode the processor, the run, or the position of the item in the underlying result set.",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Label",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/OperationKind"
        },
        "relative_path": {
          "description": "Path within the review package directory.",
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "label",
        "relative_path",
        "operation",
        "category",
        "dimensions"
      ],
      "title": "ReviewItem",
      "type": "object"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/v1/review-package.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a reviewer receives: images, labels, and the questions to answer.",
  "properties": {
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "critical_failures": {
      "default": [
        "identity_changed",
        "text_or_logo_changed",
        "content_added_or_removed",
        "severe_tiling_seams",
        "broken_transparency",
        "orientation_corrupted",
        "silent_colour_space_conversion",
        "worse_than_baseline_unwarned"
      ],
      "description": "The failure conditions reviewers may raise. All eight, always: a package that offered a subset would be deciding in advance which failures are possible.",
      "items": {
        "$ref": "#/$defs/CriticalFailure"
      },
      "title": "Critical Failures",
      "type": "array"
    },
    "instructions": {
      "default": "",
      "title": "Instructions",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ReviewItem"
      },
      "title": "Items",
      "type": "array"
    },
    "operation": {
      "$ref": "#/$defs/OperationKind"
    },
    "package_id": {
      "description": "Content-addressed identifier produced by ipw.benchmark_runner.ids.",
      "pattern": "^(run|res|rep|mfst|pol|rt|ast)_[a-z2-7]{32}$",
      "title": "Package Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.5.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "operation",
    "created_at",
    "items"
  ],
  "title": "ReviewPackage",
  "type": "object"
}
