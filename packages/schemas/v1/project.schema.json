{
  "$defs": {
    "ProjectNodeKind": {
      "description": "Project hierarchy node type.",
      "enum": [
        "project",
        "collection",
        "subproject"
      ],
      "title": "ProjectNodeKind",
      "type": "string"
    }
  },
  "$id": "https://image-pdf-workspace.packages/schemas/v1/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Project, collection or subproject metadata.",
  "properties": {
    "archived": {
      "default": false,
      "title": "Archived",
      "type": "boolean"
    },
    "kind": {
      "$ref": "#/$defs/ProjectNodeKind",
      "default": "project"
    },
    "name": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "parent_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.6.0",
      "description": "Contract version. Unsupported versions must be rejected before work starts.",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "workspace_id",
    "name"
  ],
  "title": "Project",
  "type": "object"
}
